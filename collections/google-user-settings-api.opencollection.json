                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": ""
              }
            ]
          },
          "docs": "Returns all user settings for the authenticated user."
        },
        {
          "info": {
            "name": "Google Get Calendar Settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.googleapis.com/books/v1/users/me/settings/:setting",
