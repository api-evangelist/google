                "name": "Accept",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "setting",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a single user setting."
        },
        {
          "info": {
            "name": "Google Watch Calendar Settings",
            "type": "http"
